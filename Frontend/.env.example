# API Gateway base URL
# All frontend requests are proxied through /api → http://localhost:8080
# Change this to point to your deployed gateway in production
VITE_API_BASE_URL=/api

# Keycloak (identity provider)
# The browser talks to Keycloak directly, so this must be the host URL,
# not the internal Docker hostname.
VITE_KEYCLOAK_URL=http://localhost:8480
VITE_KEYCLOAK_REALM=myheart
VITE_KEYCLOAK_CLIENT_ID=myheart-frontend

# Dev-server proxy target for /api. Default is http://localhost:8080.
VITE_API_PROXY_TARGET=http://localhost:8080

# ── Demo mode ───────────────────────────────────────────────────
# Serves the interface against in-memory fixtures instead of the gateway, with
# no Keycloak and no network. Used for the hosted demo, which is a static build
# on Cloudflare Pages: nobody evaluating this is going to start sixteen
# containers, and a front end that can answer its own requests can be hosted
# permanently for nothing.
#
# Leave this unset for real use. See src/demo/ for what it does and does not
# reproduce.
VITE_DEMO_MODE=false
