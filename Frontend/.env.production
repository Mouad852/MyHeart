# Loaded by `vite build`. The only production build of this front end is the
# hosted demo, so demo mode is the default here rather than a setting somebody
# has to remember in a dashboard - forgetting it produces a build that hangs on
# "Checking your session" reaching for a Keycloak that is not there.
#
# A real deployment with a real gateway overrides this: an actual environment
# variable takes precedence over a .env file in Vite.
#
#   VITE_DEMO_MODE=false npm run build
#
VITE_DEMO_MODE=true
