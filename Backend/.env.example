# ============================================================
# MedCore — environment template
#
# Copy this file to .env and replace every "change_me" value:
#     cp .env.example .env
#
# .env is gitignored and must never be committed.
# ============================================================

# ── Per-service database credentials ────────────────────────
PATIENT_DB_USER=postgres
PATIENT_DB_PASSWORD=change_me

DOCTOR_DB_USER=postgres
DOCTOR_DB_PASSWORD=change_me

APPOINTMENT_DB_USER=postgres
APPOINTMENT_DB_PASSWORD=change_me

BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=change_me

PRESCRIPTION_DB_USER=prescription_user
PRESCRIPTION_DB_PASSWORD=change_me

LAB_DB_USER=lab_user
LAB_DB_PASSWORD=change_me

# ── Keycloak ────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change_me
KEYCLOAK_REALM=myheart

# Internal URL used by services on the Docker network to fetch signing keys.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# Issuer stamped into tokens, as reached by the browser from the host.
KEYCLOAK_ISSUER_URI=http://localhost:8480/realms/myheart

# ── CORS (comma-separated; never use * in a deployed env) ───
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
