{
  "realm": "myheart",
  "enabled": true,
  "displayName": "MedCore Clinic Operations",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Full platform access"
      },
      {
        "name": "DOCTOR",
        "description": "Clinical workspace: appointments, prescriptions, lab requests"
      },
      {
        "name": "PATIENT",
        "description": "Self-service portal, limited to the patient's own records"
      },
      {
        "name": "RECEPTIONIST",
        "description": "Front desk: registration, scheduling, confirmations"
      },
      {
        "name": "BILLING",
        "description": "Invoices, payments and financial exports"
      },
      {
        "name": "NURSE",
        "description": "Read access to patient clinical data"
      },
      {
        "name": "LAB_TECHNICIAN",
        "description": "Laboratory queue and result upload"
      }
    ]
  },
  "clients": [
    {
      "clientId": "myheart-frontend",
      "name": "MedCore React Frontend",
      "description": "Public SPA client using Authorization Code Flow with PKCE",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "patientId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "patientId",
            "claim.name": "patientId",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "doctorId",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "doctorId",
            "claim.name": "doctorId",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin.demo",
      "email": "admin.demo@medcore.local",
      "firstName": "Amina",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "DemoPass123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
